{
  "name": "grok-bot-lobby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4521",
    "build": "next build",
    "start": "next start --port 4521",
    "lint": "eslint",
    "join-lobby": "node --experimental-strip-types --no-warnings scripts/join-lobby.ts",
    "sync-token": "node --experimental-strip-types --no-warnings scripts/sync-token.ts",
    "propose-exchange": "node --experimental-strip-types --no-warnings scripts/propose-exchange.ts",
    "load-test-45": "node --experimental-strip-types --no-warnings scripts/load-test-45.ts",
    "lobby-bridge": "node --experimental-strip-types --no-warnings scripts/lobby-bridge.ts",
    "list-bots": "node --experimental-strip-types --no-warnings scripts/list-bots.ts",
    "context-from-bot": "node --experimental-strip-types --no-warnings scripts/context-from-bot.ts",
    "standing-rules": "node --experimental-strip-types --no-warnings scripts/standing-rules.ts",
    "transcribe-hook": "node --experimental-strip-types --no-warnings scripts/transcribe-hook.ts",
    "tunnel": "bash scripts/start-tunnel.sh",
    "tunnel:setup": "bash scripts/setup-tunnel.sh",
    "tunnel:install": "bash scripts/install-tunnel-service.sh",
    "tunnel:uninstall": "bash scripts/uninstall-tunnel-service.sh",
    "tunnel:quick": "cloudflared tunnel --url http://127.0.0.1:4521",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  }
}
