# Stable public lobby URL (named Cloudflare Tunnel — NOT ephemeral trycloudflare).
# Set after: npm run tunnel:setup
# Restart `npm run dev` after changing.
LOBBY_PUBLIC_URL=https://lobby.example.com
NEXT_PUBLIC_LOBBY_PUBLIC_URL=https://lobby.example.com

# Optional: add hostname to Next.js allowedDevOrigins without full URL
# LOBBY_TUNNEL_HOSTNAME=lobby.example.com
