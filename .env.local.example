# Public lobby URL when exposing localhost via Cloudflare Tunnel (quick tunnel or named tunnel).
# Copy to .env.local and set after `npm run tunnel` prints the trycloudflare.com URL.
# Restart `npm run dev` after changing.
LOBBY_PUBLIC_URL=https://your-subdomain.trycloudflare.com
NEXT_PUBLIC_LOBBY_PUBLIC_URL=https://your-subdomain.trycloudflare.com
