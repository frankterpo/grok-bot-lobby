# Host authentication secret (required in production via wrangler secret).
# Local dev uses this value, or falls back to gbl-dev-host-secret-change-me if unset.
HOST_SECRET=change-me-to-a-long-random-string

# Stable public lobby URL (named Cloudflare Tunnel — NOT ephemeral trycloudflare).
#
# Required for remote join links (ShareLink / EventCodeChip). Without this file,
# the UI shows localhost and a "Not shareable remotely" banner.
#
# After tunnel setup:
#   npm run tunnel:setup -- --hostname lobby.yourdomain.com --zone yourdomain.com
#   cp .env.local.example .env.local
#   # Replace lobby.example.com below with your real tunnel hostname
# Restart `npm run dev` after changing.
LOBBY_PUBLIC_URL=https://lobby.example.com
NEXT_PUBLIC_LOBBY_PUBLIC_URL=https://lobby.example.com

# Optional: add hostname to Next.js allowedDevOrigins without full URL
# LOBBY_TUNNEL_HOSTNAME=lobby.example.com
